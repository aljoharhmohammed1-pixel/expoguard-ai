    "/v1/analyze/image": {
      "post": {
        "summary": "Analyze Image",
        "description": "Fire/smoke and optional Crowd V1 in one image. cameraId resolves host-configured normalized polygon ROI and capacity. Configured zone mapping is authoritative; conflicts return 422. Missing configuration safely skips crowd. HIGH/CRITICAL produce human-review candidates, never incidents. See README for DEMO-CROWD setup.",
        "operationId": "analyze_image_v1_analyze_image_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_image_v1_analyze_image_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedAnalysis"
                },
                "example": {
                  "schemaVersion": "2.0.0",
                  "requestId": "example-only",
                  "inputType": "IMAGE",
                  "imageId": "example-image",
                  "textId": null,
                  "audioId": null,
                  "analysisStatus": "OK",
                  "modelVersion": "fire-smoke-infernoguard-v1.0.0",
                  "policyVersion": "fire-review-v0.3.0",
                  "componentVersions": {
                    "crowd": "yolo26n-person-v1.0.0"
                  },
                  "imageQuality": {
                    "usable": true,
                    "issues": []
                  },
                  "crowdMetrics": {
                    "peopleCount": 4,
                    "capacity": 4,
                    "occupancyRatio": 1.0,
                    "crowdLevel": "CRITICAL",
                    "cameraId": "DEMO-CROWD",
                    "zoneId": null,
                    "roiApplied": false
                  },
                  "transcript": null,
                  "detections": [
                    {
                      "detectionId": "crowd-count-1",
                      "modality": "IMAGE",
                      "label": "visible_people_count",
                      "confidence": null,
                      "bbox": null,
                      "evidence": "4 visible people inside the configured monitoring area; capacity 4.",
                      "textSpan": null
                    }
                  ],
                  "candidates": [
                    {
                      "candidateId": "crowd-cand-1",
                      "detectionIds": [
                        "crowd-count-1"
                      ],
                      "category": "CROWD",
                      "severity": null,
                      "confidence": null,
                      "summaryAr": "رُصد 4 شخصًا ضمن نطاق المراقبة؛ مستوى الإشغال التشغيلي يستدعي المراجعة.",
                      "zoneId": null,
                      "assetId": null,
                      "affectsAccessibility": null,
                      "decision": "REVIEW",
                      "requiresHumanReview": true,
                      "decisionReason": "Visible count meets a configured review threshold; this is not a certified safety assessment.",
                      "mentionedZone": null
                    }
                  ],
                  "limitations": [
                    "Synthetic documentation example; not measured results.",
                    "Single-frame visible people only; occlusion and camera angle affect counts.",
                    "Configured MVP operational thresholds are not certified crowd-safety limits.",
                    "No identity, tracking, entry/exit flow, speed or prediction."
                  ],
                  "error": null
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
