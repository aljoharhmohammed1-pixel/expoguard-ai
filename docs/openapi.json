          "requestId",
          "imageId",
          "source",
          "capturedAt"
        ],
        "title": "Body_analyze_image_v1_analyze_image_post"
      },
      "CorrelationPolicy": {
        "properties": {
          "windowSeconds": {
            "type": "integer",
            "maximum": 86400.0,
            "exclusiveMinimum": 0.0,
            "title": "Windowseconds",
            "default": 300
          },
          "reviewThreshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Reviewthreshold",
            "default": 0.7
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CorrelationPolicy"
      },
      "CorrelationProposal": {
        "properties": {
          "alertIds": {
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Alertids"
          },
          "policyVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Policyversion",
            "default": "correlation-heuristic-v0.1.0"
          },
          "windowSeconds": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Windowseconds"
          },
          "reviewThreshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Reviewthreshold"
          },
          "decision": {
            "type": "string",
            "enum": [
              "REVIEW_LINK",
              "NO_SUGGESTION",
              "SAME_ALERT"
            ],
            "title": "Decision"
          },
          "correlationScore": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlationscore"
          },
          "lexicalSimilarity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lexicalsimilarity"
          },
          "timeDeltaSeconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Timedeltaseconds"
          },
          "reasons": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "title": "Reasons"
          },
          "requiresHumanReview": {
            "type": "boolean",
            "const": true,
            "title": "Requireshumanreview",
            "default": true
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "alertIds",
          "windowSeconds",
          "reviewThreshold",
          "decision",
          "correlationScore",
          "lexicalSimilarity",
          "timeDeltaSeconds",
          "reasons"
        ],
        "title": "CorrelationProposal"
      },
      "CorrelationRequest": {
        "properties": {
          "left": {
            "$ref": "#/components/schemas/AlertFacts"
