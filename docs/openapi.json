          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedAnalysis"
                },
                "example": {
                  "schemaVersion": "2.0.0",
                  "requestId": "example-only",
                  "inputType": "IMAGE",
                  "imageId": "example-image",
                  "textId": null,
                  "audioId": null,
                  "analysisStatus": "ERROR",
                  "modelVersion": "fire-smoke-infernoguard-v1.0.0",
                  "policyVersion": "fire-review-v0.3.0",
                  "componentVersions": {},
                  "imageQuality": {
                    "usable": true,
                    "issues": []
                  },
                  "transcript": null,
                  "detections": [],
                  "candidates": [],
                  "limitations": [],
                  "error": {
                    "code": "PERSON_INFERENCE_FAILED",
                    "message": "Crowd analysis could not be completed."
                  }
                }
              }
            }
          }
        }
      }
