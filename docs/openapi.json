            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "playbookId",
          "playbookVersion",
          "playbookSha256",
          "sourceRef",
          "sourceSection",
          "stepId",
          "textAr",
          "evidenceIds"
        ],
        "title": "ActionProposal"
      },
      "AlertFacts": {
        "properties": {
          "alertId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Alertid"
          },
          "category": {
            "type": "string",
            "enum": [
              "FIRE",
              "CROWD",
              "MEDICAL",
              "ACCESSIBILITY",
              "TECHNICAL_FAILURE",
              "CLEANLINESS",
              "SECURITY",
              "OTHER"
            ],
            "title": "Category"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Observedat"
          },
          "zoneId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zoneid"
          },
          "assetId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assetid"
          },
          "eventId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eventid"
          },
          "summary": {
            "type": "string",
            "maxLength": 20000,
            "title": "Summary",
            "default": ""
          },
          "aiConfidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Aiconfidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "alertId",
          "category",
          "observedAt"
        ],
        "title": "AlertFacts"
      },
      "Body_analyze_image_v1_analyze_image_post": {
        "properties": {
          "file": {
            "type": "string",
